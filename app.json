{
  "expo": {
    "name": "SmartTrip AI",
    "slug": "smarttrip-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logoicon2.jpg",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/lg8.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "extra": {
      "EXPO_GOOGLE_MAP_KEY": "your-google-api-key-here",
      "RAPIDAPI_KEY": "your-rapidapi-key-here",
      "eas": {
        "projectId": "c85a6fba-6ac0-41eb-9085-ba819b3d741b"
      }
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logoicon2.jpg",
        "backgroundColor": "#ffffff"
      },
      "package": "com.yash_gahlot.AITravelPlannerApp"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./app"
        }
      ]
    ],
    "owner": "yashh-gahlot"
  }
}